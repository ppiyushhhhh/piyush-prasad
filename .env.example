# ---------------------------------------------------------------
# Example environment file — variable NAMES only.
# NEVER commit real credentials, keys, tokens or passwords.
# Copy to .env (git-ignored) and fill in locally / in CI secrets.
# ---------------------------------------------------------------

# --- Site (build/runtime, safe to expose) ---
VITE_SITE_URL=

# ---------------------------------------------------------------
# Daily Website Health Report (scripts/generate-report.mjs)
# These are GitHub Actions repository secrets — never client-side.
# ---------------------------------------------------------------
SITE_DOMAIN=

# SMTP delivery (SECRET)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Report delivery
REPORT_TO=
REPORT_FROM=
ALERT_TO=

# Report branding / contact block (non-secret, safe fallbacks exist)
REPORT_BRAND_NAME=
REPORT_BRAND_TAGLINE=
REPORT_CONTACT_EMAIL=
REPORT_CONTACT_PHONE=
REPORT_LINKEDIN=
REPORT_GITHUB=

# Set to 1 to generate the PDF without sending email
SKIP_EMAIL=
