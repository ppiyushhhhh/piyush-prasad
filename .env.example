# ---------------------------------------------------------------
# Example environment file — variable NAMES only.
# NEVER commit real credentials, keys, tokens or passwords.
# Copy to .env (git-ignored) and fill in locally / in CI secrets.
# ---------------------------------------------------------------

# --- Site (build/runtime, safe to expose) ---
VITE_SITE_URL=

# ---------------------------------------------------------------
# Daily Website Health Report (scripts/generate-report.mjs)
# These are GitHub Actions repository secrets — never client-side.
# ---------------------------------------------------------------
SITE_DOMAIN=

# SMTP delivery (SECRET)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Report delivery
REPORT_TO=
REPORT_FROM=
ALERT_TO=

# Report branding / contact block (non-secret, safe fallbacks exist)
REPORT_BRAND_NAME=
REPORT_BRAND_TAGLINE=
REPORT_CONTACT_EMAIL=
REPORT_CONTACT_PHONE=
REPORT_LINKEDIN=
REPORT_GITHUB=

# Set to 1 to generate the PDF without sending email
SKIP_EMAIL=

# ---------------------------------------------------------------
# AI Portfolio Assistant (server-side only — never expose to the browser)
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Contact form (public client-side identifier, safe to expose) ---
VITE_WEB3FORMS_ACCESS_KEY=

# --- Firebase (public client-side config, safe to expose) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
