# -----------------------------------------------------------------------------
# STAGING ENVIRONMENT TEMPLATE (.env.staging.example)
#
# Target Staging Domain: https://test.piyushprasad.in
# Local Staging URL:     http://localhost:3001
#
# INSTRUCTIONS:
# Copy this file to `.env.staging` (which is git-ignored) for local staging runs.
# NEVER commit credentials or service-role keys to version control.
# -----------------------------------------------------------------------------

# --- Environment Mode ---
# Identifies the environment to the frontend and runtime.
# Automatically displays the subtle "STAGING" badge in the navigation bar
# and enables write-isolation protections against production databases.
VITE_APP_ENV=staging

# --- Public Site URL & Domain ---
# Used for metadata, canonical URLs, and local staging testing
VITE_SITE_URL=http://localhost:3001
SITE_DOMAIN=test.piyushprasad.in

# -----------------------------------------------------------------------------
# Supabase Staging Project Configuration
#
# IMPORTANT PRODUCTION ISOLATION RULE:
# Provision a dedicated Supabase staging project (e.g., 'piyush-portfolio-staging').
# Run your migrations against the staging project.
#
# If the staging environment points to the production Supabase project ID,
# the built-in Staging Guard automatically enforces READ-ONLY mode to prevent
# any accidental inserts, updates, or deletions against live production data.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_staging_key_here
VITE_SUPABASE_PROJECT_ID=your-staging-project-ref

# Server-side Supabase credentials (never exposed to browser bundles)
SUPABASE_URL=https://your-staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_staging_service_role_key_here
SUPABASE_PROJECT_ID=your-staging-project-ref

# -----------------------------------------------------------------------------
# Email & Contact Notification Isolation
#
# In staging mode (VITE_APP_ENV=staging), the email dispatcher intercepts all
# outbound emails and logs them to the console instead of sending live emails.
# Setting SKIP_EMAIL=1 provides an additional explicit safety layer.
# -----------------------------------------------------------------------------
SKIP_EMAIL=1
CONTACT_FROM_EMAIL=staging@test.piyushprasad.in
CONTACT_NOTIFICATION_EMAIL=dev-staging@piyushprasad.in

# Primary Email Provider for Staging (Optional - leaving empty uses simulated delivery)
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# AI Assistant (Ask Piyush AI) in Staging
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Web3Forms Fallback Access Key (Staging / Test Key)
# -----------------------------------------------------------------------------
VITE_WEB3FORMS_ACCESS_KEY=

